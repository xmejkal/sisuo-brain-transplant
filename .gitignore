node_modules/
dist/
_scratch/
_seeed/
*.log
__pycache__/
*.pyc

# Wokwi: firmware binaries and anything holding a token
# The MicroPython build (not ours, megabytes) and the flash images derived from it.
# NOTE: .gitignore has no trailing comments — a comment after a pattern makes the pattern
# match nothing, which is how three 4 MB binaries ended up committed.
firmware/micropython/sim/*.bin
.env
*.token
firmware/micropython/sim/chips/*.wasm
firmware/micropython/sim/chips/wokwi-api.h

# tscircuit's build cache: derived, machine-specific, regenerated on every build.
.tscircuit/cache/

# The findings store's lock file, held only while a write is in flight.
.spark/findings.lock
